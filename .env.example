# Copy to .env in the same directory as the running binary (LoadEnv() reads
# ".env" relative to the process's working directory - see initializers/env_loader.go).
# Missing/unreadable .env is fatal on startup.

# --- Network ---
BIND_HOST=0.0.0.0
BIND_PORT=3000

# --- Database (Microsoft SQL Server) ---
# ConnectDb() (initializers/db_connector.go) builds a sqlserver:// DSN from these.
# Connection failure is fatal on startup.
DB_USERNAME=
DB_PASSWORD=
DB_HOST=
DB_PORT=1433
DB_NAME=

# --- Auth ---
# HS256 signing secret for issued JWTs (utils/token_util.go, middlewares/auth_requirer.go).
# HRIS's own SECRET_KEY (D:\HRIS\.env) MUST equal this value exactly - HRIS only ever
# validates tokens this API issues, it never issues its own.
SECRET_KEY=

# --- Optional ---
# Absolute path for uploaded attachments (services/file_service.go). Defaults to
# "./files" (relative to CWD) if unset - set this explicitly in production so
# uploads don't end up somewhere unexpected if the working directory ever changes.
# FILES_DIR=

# --- Not yet configurable via env - documented here so it isn't missed ---
# Redis is hardcoded to localhost:6379 with no auth (initializers/redis_initializer.go).
# It must be running on THIS SAME MACHINE before the API starts - InitRedis() calls
# log.Fatal if it can't connect. No env var exists to point it elsewhere.
